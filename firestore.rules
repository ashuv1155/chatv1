rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimaryOwnerEmail() {
      return isSignedIn() &&
        request.auth.token.email == '8887ashu@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        isPrimaryOwnerEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isModerator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    function isStaff() {
      return isSuperAdmin() || isModerator();
    }

    function canModBan() {
      return isSuperAdmin() || (
        isModerator() &&
        get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.canBan == true
      );
    }

    function canModReports() {
      return isSuperAdmin() || (
        isModerator() &&
        get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.canManageReports == true
      );
    }

    function canModRooms() {
      return isSuperAdmin() || (
        isModerator() &&
        get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.canManageRooms == true
      );
    }

    function isTargetStaff(userId) {
      return exists(/databases/$(database)/documents/admins/$(userId)) ||
        exists(/databases/$(database)/documents/moderators/$(userId));
    }

    function isChatMember(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid));
    }

    function isGroupAdmin(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid;
    }

    function isUserBanned(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId)) &&
        get(/databases/$(database)/documents/profiles/$(userId)).data.banned == true;
    }

    function isValidHexColor(color) {
      return color is string && color.size() == 7 && color.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 32 && name.matches('^[A-Za-z0-9_]+$');
    }

    function isValidAvatarDataUrl(val) {
      return val == null || (
        val is string &&
        val.size() <= 220000 &&
        val.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$')
      );
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidProfile(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'color', 'banned', 'lastUsernameChangeAt', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'username', 'color', 'bio', 'avatarUrl', 'usernameHistory', 'banned', 'bannedReason', 'bannedAt', 'lastUsernameChangeAt', 'createdAt']) &&
        data.uid is string && data.uid == userId &&
        isValidUsername(data.username) &&
        isValidHexColor(data.color) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
        (!('avatarUrl' in data) || isValidAvatarDataUrl(data.avatarUrl)) &&
        (!('usernameHistory' in data) || (
          data.usernameHistory is list &&
          data.usernameHistory.size() <= 20 &&
          (data.usernameHistory.size() == 0 || data.usernameHistory[0] is map)
        )) &&
        data.banned is bool &&
        (!('bannedReason' in data) || data.bannedReason == null || (data.bannedReason is string && data.bannedReason.size() <= 240)) &&
        (!('bannedAt' in data) || data.bannedAt == null || data.bannedAt is timestamp) &&
        (data.lastUsernameChangeAt == null || data.lastUsernameChangeAt is timestamp) &&
        data.createdAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'color', 'addedBy', 'addedByUsername', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'username', 'color', 'addedBy', 'addedByUsername', 'note', 'createdAt']) &&
        data.uid is string && data.uid == userId &&
        isValidUsername(data.username) &&
        isValidHexColor(data.color) &&
        data.addedBy is string && data.addedBy == request.auth.uid &&
        isValidUsername(data.addedByUsername) &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 200)) &&
        data.createdAt is timestamp;
    }

    function isValidModeratorRecord(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'color', 'canBan', 'canManageReports', 'canManageRooms', 'addedBy', 'addedByUsername', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'username', 'color', 'canBan', 'canManageReports', 'canManageRooms', 'note', 'addedBy', 'addedByUsername', 'createdAt']) &&
        data.uid is string && data.uid == userId &&
        isValidUsername(data.username) &&
        isValidHexColor(data.color) &&
        data.canBan is bool &&
        data.canManageReports is bool &&
        data.canManageRooms is bool &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 200)) &&
        data.addedBy is string && isValidId(data.addedBy) &&
        isValidUsername(data.addedByUsername) &&
        data.createdAt is timestamp;
    }

    function isValidDeletedUser(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'deletedBy', 'deletedByUsername', 'deletedAt']) &&
        data.keys().hasOnly(['uid', 'username', 'reason', 'deletedBy', 'deletedByUsername', 'deletedAt']) &&
        data.uid is string && data.uid == userId &&
        isValidUsername(data.username) &&
        (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 240)) &&
        data.deletedBy is string && data.deletedBy == request.auth.uid &&
        isValidUsername(data.deletedByUsername) &&
        data.deletedAt is timestamp;
    }

    function isValidUserActivity(data, userId) {
      return data.keys().hasAll(['uid', 'lastSeenAt', 'sessionCount', 'messagesSentCount', 'lastScreen']) &&
        data.keys().hasOnly(['uid', 'lastSeenAt', 'sessionCount', 'messagesSentCount', 'lastScreen']) &&
        data.uid is string && data.uid == userId &&
        data.lastSeenAt is timestamp &&
        data.sessionCount is int && data.sessionCount >= 0 && data.sessionCount <= 1000000 &&
        data.messagesSentCount is int && data.messagesSentCount >= 0 && data.messagesSentCount <= 10000000 &&
        data.lastScreen in ['chat', 'profile', 'settings', 'terms', 'admin'];
    }

    function isValidModerationLog(data) {
      return data.keys().hasAll(['actorId', 'actorUsername', 'actorRole', 'action', 'details', 'createdAt']) &&
        data.keys().hasOnly(['actorId', 'actorUsername', 'actorRole', 'action', 'targetUserId', 'targetUsername', 'targetChatId', 'details', 'createdAt']) &&
        data.actorId is string && data.actorId == request.auth.uid &&
        isValidUsername(data.actorUsername) &&
        data.actorRole in ['admin', 'moderator'] &&
        data.action in [
          'ban_user',
          'unban_user',
          'delete_user',
          'restore_user',
          'add_moderator',
          'update_moderator',
          'remove_moderator',
          'add_admin',
          'remove_admin',
          'resolve_report',
          'dismiss_report',
          'reset_profile',
          'reset_ratelimit',
          'delete_room'
        ] &&
        (!('targetUserId' in data) || data.targetUserId == null || isValidId(data.targetUserId)) &&
        (!('targetUsername' in data) || data.targetUsername == null || (data.targetUsername is string && data.targetUsername.size() <= 32)) &&
        (!('targetChatId' in data) || data.targetChatId == null || isValidId(data.targetChatId)) &&
        data.details is string && data.details.size() <= 300 &&
        data.createdAt is timestamp;
    }

    function isValidUserChatLink(data, chatId) {
      return data.keys().hasAll(['chatId', 'type', 'name', 'description', 'partnerId', 'partnerUsername', 'partnerColor', 'joinedAt']) &&
        data.keys().hasOnly(['chatId', 'type', 'visibility', 'name', 'description', 'partnerId', 'partnerUsername', 'partnerColor', 'lastMessageAt', 'lastMessagePreview', 'lastSenderId', 'lastSenderUsername', 'lastReadAt', 'isFavorite', 'pinned', 'muted', 'archived', 'markedUnread', 'joinedAt']) &&
        data.chatId is string && data.chatId == chatId &&
        data.type in ['dm', 'group'] &&
        (!('visibility' in data) || data.visibility in ['public', 'private']) &&
        (data.name == null || (data.name is string && data.name.size() >= 2 && data.name.size() <= 60)) &&
        (data.description == null || (data.description is string && data.description.size() <= 200)) &&
        (data.partnerId == null || isValidId(data.partnerId)) &&
        (data.partnerUsername == null || isValidUsername(data.partnerUsername)) &&
        (data.partnerColor == null || isValidHexColor(data.partnerColor)) &&
        (!('lastMessageAt' in data) || data.lastMessageAt == null || data.lastMessageAt is timestamp) &&
        (!('lastMessagePreview' in data) || data.lastMessagePreview == null || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 140)) &&
        (!('lastSenderId' in data) || data.lastSenderId == null || isValidId(data.lastSenderId)) &&
        (!('lastSenderUsername' in data) || data.lastSenderUsername == null || isValidUsername(data.lastSenderUsername)) &&
        (!('lastReadAt' in data) || data.lastReadAt == null || data.lastReadAt is timestamp) &&
        (!('isFavorite' in data) || data.isFavorite is bool) &&
        (!('pinned' in data) || data.pinned is bool) &&
        (!('muted' in data) || data.muted is bool) &&
        (!('archived' in data) || data.archived is bool) &&
        (!('markedUnread' in data) || data.markedUnread is bool) &&
        data.joinedAt is timestamp;
    }

    function isValidBlock(data, blockerId, blockedId) {
      return data.keys().hasAll(['blockerId', 'blockedId', 'blockedUsername', 'blockedColor', 'createdAt']) &&
        data.keys().hasOnly(['blockerId', 'blockedId', 'blockedUsername', 'blockedColor', 'createdAt']) &&
        data.blockerId is string && data.blockerId == blockerId &&
        data.blockedId is string && data.blockedId == blockedId &&
        isValidUsername(data.blockedUsername) &&
        isValidHexColor(data.blockedColor) &&
        data.createdAt is timestamp;
    }

    function isValidFriendNickname(data, ownerId, targetUserId) {
      return data.keys().hasAll(['ownerId', 'targetUserId', 'nickname', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'targetUserId', 'nickname', 'updatedAt']) &&
        data.ownerId is string && data.ownerId == ownerId &&
        data.targetUserId is string && data.targetUserId == targetUserId &&
        data.nickname is string && data.nickname.trim().size() >= 1 && data.nickname.size() <= 32 &&
        data.updatedAt is timestamp;
    }

    function isValidFavorite(data, ownerId, targetUserId) {
      return data.keys().hasAll(['ownerId', 'targetUserId', 'username', 'color', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'targetUserId', 'username', 'color', 'createdAt']) &&
        data.ownerId is string && data.ownerId == ownerId &&
        data.targetUserId is string && data.targetUserId == targetUserId &&
        isValidUsername(data.username) &&
        isValidHexColor(data.color) &&
        data.createdAt is timestamp;
    }

    function isValidRateLimit(data, userId) {
      return data.keys().hasAll(['uid', 'windowStart', 'count', 'lastMessageId']) &&
        data.keys().hasOnly(['uid', 'windowStart', 'count', 'lastMessageId']) &&
        data.uid is string && data.uid == userId &&
        data.windowStart is timestamp &&
        data.count is int && data.count >= 1 && data.count <= 5 &&
        isValidId(data.lastMessageId);
    }

    function isValidChat(data) {
      return data.keys().hasAll(['type', 'name', 'description', 'dmKey', 'createdBy', 'memberCount', 'createdAt']) &&
        data.keys().hasOnly(['type', 'visibility', 'name', 'description', 'dmKey', 'createdBy', 'memberCount', 'lastMessageAt', 'lastMessagePreview', 'lastSenderId', 'lastSenderUsername', 'createdAt']) &&
        data.type in ['dm', 'group'] &&
        (!('visibility' in data) || data.visibility in ['public', 'private']) &&
        (
          (data.type == 'group' && data.name is string && data.name.trim().size() >= 2 && data.name.size() <= 60 && data.dmKey == null) ||
          (data.type == 'dm' && data.name == null && data.description == null && data.dmKey is string && data.dmKey.size() >= 3 && data.dmKey.size() <= 260)
        ) &&
        (data.description == null || (data.description is string && data.description.size() <= 200)) &&
        isValidId(data.createdBy) &&
        data.memberCount is int && data.memberCount >= 0 &&
        (!('lastMessageAt' in data) || data.lastMessageAt == null || data.lastMessageAt is timestamp) &&
        (!('lastMessagePreview' in data) || data.lastMessagePreview == null || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 140)) &&
        (!('lastSenderId' in data) || data.lastSenderId == null || isValidId(data.lastSenderId)) &&
        (!('lastSenderUsername' in data) || data.lastSenderUsername == null || isValidUsername(data.lastSenderUsername)) &&
        data.createdAt is timestamp;
    }

    function isValidChatMember(data, memberId) {
      return data.keys().hasAll(['userId', 'username', 'color', 'joinedAt']) &&
        data.keys().hasOnly(['userId', 'username', 'color', 'joinedAt']) &&
        data.userId is string && data.userId == memberId &&
        isValidUsername(data.username) &&
        isValidHexColor(data.color) &&
        data.joinedAt is timestamp;
    }

    function isValidTypingState(data, userId) {
      return data.keys().hasAll(['userId', 'username', 'color', 'isTyping', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'username', 'color', 'isTyping', 'updatedAt']) &&
        data.userId is string && data.userId == userId &&
        isValidUsername(data.username) &&
        isValidHexColor(data.color) &&
        data.isTyping is bool &&
        data.updatedAt is timestamp;
    }

    function isValidJoinRequest(data, requesterId) {
      return data.keys().hasAll(['userId', 'username', 'color', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'username', 'color', 'status', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == requesterId &&
        isValidUsername(data.username) &&
        isValidHexColor(data.color) &&
        data.status in ['pending', 'approved', 'declined'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttachmentMeta(att) {
      return att == null || (
        att is map &&
        att.keys().hasAll(['id', 'kind', 'fileName', 'mimeType', 'sizeBytes', 'chunkCount']) &&
        att.keys().hasOnly(['id', 'kind', 'fileName', 'mimeType', 'sizeBytes', 'chunkCount']) &&
        isValidId(att.id) &&
        att.kind in ['photo', 'view_once_photo', 'file'] &&
        att.fileName is string && att.fileName.size() >= 1 && att.fileName.size() <= 180 &&
        att.mimeType is string && att.mimeType.size() >= 1 && att.mimeType.size() <= 120 &&
        att.sizeBytes is int && att.sizeBytes >= 1 && att.sizeBytes <= 5242880 &&
        att.chunkCount is int && att.chunkCount >= 1 && att.chunkCount <= 16
      );
    }

    function isValidReplyMeta(reply) {
      return reply == null || (
        reply is map &&
        reply.keys().hasAll(['messageId', 'senderUsername', 'snippet']) &&
        reply.keys().hasOnly(['messageId', 'senderUsername', 'snippet']) &&
        isValidId(reply.messageId) &&
        isValidUsername(reply.senderUsername) &&
        reply.snippet is string && reply.snippet.size() <= 160
      );
    }

    function isValidReaction(data, reactionId) {
      return data.keys().hasAll(['messageId', 'userId', 'username', 'emoji', 'updatedAt']) &&
        data.keys().hasOnly(['messageId', 'userId', 'username', 'emoji', 'updatedAt']) &&
        isValidId(data.messageId) &&
        data.userId is string && data.userId == request.auth.uid &&
        reactionId == data.messageId + '_' + request.auth.uid &&
        isValidUsername(data.username) &&
        data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16 &&
        data.updatedAt is timestamp;
    }

    function isValidReadReceipt(data, userId) {
      return data.keys().hasAll(['userId', 'lastDeliveredAt']) &&
        data.keys().hasOnly(['userId', 'lastReadAt', 'lastDeliveredAt']) &&
        data.userId is string && data.userId == userId &&
        data.lastDeliveredAt is timestamp &&
        (!('lastReadAt' in data) || data.lastReadAt == null || data.lastReadAt is timestamp);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderUsername', 'senderColor', 'body', 'createdAt']) &&
        data.keys().hasOnly(['senderId', 'senderUsername', 'senderColor', 'body', 'attachment', 'replyTo', 'forwarded', 'createdAt', 'expiresAt']) &&
        data.senderId is string && data.senderId == request.auth.uid &&
        isValidUsername(data.senderUsername) &&
        isValidHexColor(data.senderColor) &&
        data.body is string && data.body.size() <= 1000 &&
        (!('attachment' in data) || isValidAttachmentMeta(data.attachment)) &&
        (!('replyTo' in data) || isValidReplyMeta(data.replyTo)) &&
        (!('forwarded' in data) || data.forwarded is bool) &&
        (data.body.trim().size() >= 1 || ('attachment' in data && data.attachment != null)) &&
        data.createdAt is timestamp &&
        (!('expiresAt' in data) || data.expiresAt is timestamp);
    }

    function isValidAttachmentChunk(data, chunkIndex) {
      return data.keys().hasAll(['messageId', 'senderId', 'index', 'isViewOnce', 'data', 'createdAt']) &&
        data.keys().hasOnly(['messageId', 'senderId', 'index', 'isViewOnce', 'data', 'createdAt']) &&
        isValidId(data.messageId) &&
        data.senderId is string && data.senderId == request.auth.uid &&
        data.index is int && data.index >= 0 && data.index < 16 && string(data.index) == chunkIndex &&
        data.isViewOnce is bool &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 900000 &&
        data.createdAt is timestamp;
    }

    function isValidMessageView(data, viewerId) {
      return data.keys().hasAll(['viewerId', 'viewedAt']) &&
        data.keys().hasOnly(['viewerId', 'viewedAt']) &&
        data.viewerId is string && data.viewerId == viewerId &&
        data.viewedAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reporterId', 'reportedUserId', 'chatId', 'messageId', 'reason', 'createdAt']) &&
        data.keys().hasOnly(['reporterId', 'reportedUserId', 'chatId', 'messageId', 'reason', 'status', 'resolvedBy', 'resolvedByUsername', 'resolutionNote', 'resolvedAt', 'createdAt']) &&
        isValidId(data.reporterId) &&
        (data.reportedUserId == null || isValidId(data.reportedUserId)) &&
        (data.chatId == null || isValidId(data.chatId)) &&
        (data.messageId == null || isValidId(data.messageId)) &&
        data.reason is string && data.reason.trim().size() >= 1 && data.reason.size() <= 500 &&
        (!('status' in data) || data.status in ['pending', 'resolved', 'dismissed']) &&
        (!('resolvedBy' in data) || data.resolvedBy == null || isValidId(data.resolvedBy)) &&
        (!('resolvedByUsername' in data) || data.resolvedByUsername == null || isValidUsername(data.resolvedByUsername)) &&
        (!('resolutionNote' in data) || data.resolutionNote == null || (data.resolutionNote is string && data.resolutionNote.size() <= 300)) &&
        (!('resolvedAt' in data) || data.resolvedAt == null || data.resolvedAt is timestamp) &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Connection Health Check Document
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
    }

    // -------------------------------------------------------------------------
    // Platform Administration & Moderation Roles
    // -------------------------------------------------------------------------
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isStaff());
      allow list: if isStaff();

      allow create: if isSuperAdmin() &&
        isValidId(userId) &&
        isValidAdminRecord(incoming(), userId) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/profiles/$(userId));

      allow update: if false;

      allow delete: if isSuperAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    match /moderators/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isStaff());
      allow list: if isStaff();

      allow create: if isSuperAdmin() &&
        isValidId(userId) &&
        isValidModeratorRecord(incoming(), userId) &&
        incoming().addedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/profiles/$(userId));

      allow update: if isSuperAdmin() &&
        isValidId(userId) &&
        isValidModeratorRecord(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().addedBy == existing().addedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['canBan', 'canManageReports', 'canManageRooms', 'note', 'username', 'color']);

      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    match /deletedUsers/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isStaff());
      allow list: if isStaff();

      allow create: if isSuperAdmin() &&
        isValidId(userId) &&
        userId != request.auth.uid &&
        isValidDeletedUser(incoming(), userId) &&
        incoming().deletedAt == request.time;

      allow update: if false;
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    match /userActivity/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isStaff());
      allow list: if isStaff();

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserActivity(incoming(), userId) &&
        incoming().lastSeenAt == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserActivity(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().lastSeenAt == request.time &&
        incoming().sessionCount >= existing().sessionCount &&
        incoming().messagesSentCount >= existing().messagesSentCount;

      allow delete: if isValidId(userId) && (
        isOwner(userId) ||
        (isSuperAdmin() && userId != request.auth.uid)
      );
    }

    match /moderationLogs/{logId} {
      allow get: if isStaff() && isValidId(logId);
      allow list: if isStaff();

      allow create: if isStaff() &&
        isValidId(logId) &&
        isValidModerationLog(incoming()) &&
        incoming().actorId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Anonymous Profiles
    // -------------------------------------------------------------------------
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && (existing().banned == false || isStaff());

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidProfile(incoming(), userId) &&
        incoming().banned == false &&
        (!('bannedReason' in incoming()) || incoming().bannedReason == null) &&
        (!('bannedAt' in incoming()) || incoming().bannedAt == null) &&
        incoming().lastUsernameChangeAt == null &&
        incoming().createdAt == request.time &&
        !exists(/databases/$(database)/documents/deletedUsers/$(userId));

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (
          // Staff ban / unban action (Moderators cannot target Super Admins or other Moderators, and nobody bans self)
          (
            userId != request.auth.uid &&
            (isSuperAdmin() || (canModBan() && !isTargetStaff(userId))) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['banned', 'bannedReason', 'bannedAt']) &&
            (!('bannedAt' in incoming()) || incoming().bannedAt == null || incoming().bannedAt == request.time)
          ) ||
          // Super Admin profile hygiene reset (clear abusive bio, avatar, or handle)
          (
            isSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['bio', 'avatarUrl', 'username', 'lastUsernameChangeAt', 'usernameHistory']) &&
            (
              !incoming().diff(existing()).affectedKeys().hasAny(['username']) ||
              incoming().lastUsernameChangeAt == request.time
            )
          ) ||
          // Profile owner self-update
          (
            isOwner(userId) &&
            !existing().banned &&
            incoming().banned == existing().banned &&
            (
              // Action: Update bio, avatarUrl, or avatar accent color
              incoming().diff(existing()).affectedKeys().hasOnly(['bio', 'avatarUrl', 'color']) ||
              // Action: Set custom username or rotate random username (records history)
              (
                incoming().color == existing().color &&
                incoming().diff(existing()).affectedKeys().hasOnly(['username', 'lastUsernameChangeAt', 'usernameHistory']) &&
                incoming().lastUsernameChangeAt == request.time
              )
            )
          )
        );

      allow delete: if isValidId(userId) && (
        isOwner(userId) ||
        (isSuperAdmin() && userId != request.auth.uid)
      );

      // User's joined groups and DM index
      match /myChats/{chatId} {
        allow get: if isValidId(userId) && isValidId(chatId) && (isOwner(userId) || isStaff());
        allow list: if isOwner(userId) || isStaff();

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(chatId) &&
          isValidUserChatLink(incoming(), chatId) &&
          incoming().joinedAt == request.time &&
          existsAfter(/databases/$(database)/documents/chats/$(chatId)/members/$(userId)) &&
          (
            isOwner(userId) ||
            (
              incoming().type == 'dm' &&
              incoming().partnerId == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid)) &&
              !exists(/databases/$(database)/documents/profiles/$(userId)/blocks/$(request.auth.uid))
            ) ||
            (
              incoming().type == 'group' &&
              isGroupAdmin(chatId)
            )
          );

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(chatId) &&
          isValidUserChatLink(incoming(), chatId) &&
          incoming().chatId == existing().chatId &&
          incoming().type == existing().type &&
          incoming().joinedAt == existing().joinedAt &&
          (
            // Owner marks conversation as read
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['lastReadAt', 'markedUnread']) &&
              incoming().lastReadAt == request.time &&
              (!('markedUnread' in incoming()) || incoming().markedUnread == false)
            ) ||
            // Owner updates chat preferences (favorite, pin, mute, archive, mark unread)
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isFavorite', 'pinned', 'muted', 'archived', 'markedUnread'])
            ) ||
            // Owner sends message and records latest preview + read state
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['lastReadAt', 'markedUnread', 'lastMessageAt', 'lastMessagePreview', 'lastSenderId', 'lastSenderUsername']) &&
              incoming().lastReadAt == request.time &&
              (!('markedUnread' in incoming()) || incoming().markedUnread == false) &&
              incoming().lastMessageAt == request.time &&
              incoming().lastSenderId == request.auth.uid
            ) ||
            // DM partner pushes latest message preview for recipient notification
            (
              existing().type == 'dm' &&
              existing().partnerId == request.auth.uid &&
              isChatMember(chatId) &&
              !isUserBanned(request.auth.uid) &&
              !exists(/databases/$(database)/documents/profiles/$(userId)/blocks/$(request.auth.uid)) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageAt', 'lastMessagePreview', 'lastSenderId', 'lastSenderUsername']) &&
              incoming().lastSenderId == request.auth.uid &&
              incoming().lastMessageAt == request.time
            )
          );

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(chatId) && (
          isOwner(userId) ||
          isSuperAdmin() ||
          canModRooms() ||
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' &&
            isGroupAdmin(chatId)
          )
        );
      }

      // User's block list
      match /blocks/{blockedUserId} {
        allow get: if isValidId(blockedUserId) && (isOwner(userId) || isStaff());
        allow list: if isOwner(userId) || isStaff();

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(blockedUserId) &&
          blockedUserId != userId &&
          isValidBlock(incoming(), userId, blockedUserId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/profiles/$(blockedUserId));

        allow delete: if isValidId(blockedUserId) && (isOwner(userId) || isSuperAdmin());
        allow update: if false;
      }

      // User's private nicknames for friends
      match /nicknames/{targetUserId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) || isSuperAdmin();

        allow create, update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(targetUserId) &&
          targetUserId != userId &&
          isValidFriendNickname(incoming(), userId, targetUserId) &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/profiles/$(targetUserId));

        allow delete: if isValidId(userId) && isValidId(targetUserId) && (isOwner(userId) || isSuperAdmin());
      }

      // User's favorite buddies
      match /favorites/{targetUserId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) || isSuperAdmin();

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(targetUserId) &&
          targetUserId != userId &&
          isValidFavorite(incoming(), userId, targetUserId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/profiles/$(targetUserId));

        allow delete: if isValidId(userId) && isValidId(targetUserId) && (isOwner(userId) || isSuperAdmin());
        allow update: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Per-User Message Rate Limit (Max 5 messages per 10 seconds)
    // -------------------------------------------------------------------------
    match /rateLimits/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isStaff());

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidRateLimit(incoming(), userId) &&
        incoming().windowStart == request.time &&
        incoming().count == 1;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidRateLimit(incoming(), userId) &&
        (
          (
            request.time < existing().windowStart + duration.value(10, 's') &&
            incoming().windowStart == existing().windowStart &&
            incoming().count == existing().count + 1
          ) ||
          (
            request.time >= existing().windowStart + duration.value(10, 's') &&
            incoming().windowStart == request.time &&
            incoming().count == 1
          )
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
    }

    // -------------------------------------------------------------------------
    // Chats, Members, Typing, Join Requests, Messages, and Attachments
    // -------------------------------------------------------------------------
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (
        existing().type == 'group' || isChatMember(chatId) || isStaff()
      );

      // Regular users can only list groups; Staff may list chats for room/traffic metrics.
      allow list: if isSignedIn() && (existing().type == 'group' || isStaff());

      allow create: if isSignedIn() &&
        isValidId(chatId) &&
        isValidChat(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        !isUserBanned(request.auth.uid) &&
        existsAfter(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid)) &&
        (
          (incoming().type == 'group' && incoming().memberCount == 1) ||
          (incoming().type == 'dm' && incoming().memberCount == 2)
        );

      allow update: if isSignedIn() &&
        isValidId(chatId) &&
        isValidChat(incoming()) &&
        incoming().type == existing().type &&
        (!('visibility' in existing()) || incoming().visibility == existing().visibility) &&
        incoming().name == existing().name &&
        incoming().description == existing().description &&
        incoming().dmKey == existing().dmKey &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        (
          // Join public group directly
          (
            existing().type == 'group' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount']) &&
            (!('visibility' in existing()) || existing().visibility == 'public') &&
            !isUserBanned(request.auth.uid) &&
            !exists(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid)) &&
            incoming().memberCount == existing().memberCount + 1
          ) ||
          // Admin approves private group member
          (
            existing().type == 'group' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount']) &&
            existing().createdBy == request.auth.uid &&
            incoming().memberCount == existing().memberCount + 1
          ) ||
          // Leave chat / self-remove membership action (group leave or account deletion)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount']) &&
            exists(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid)) &&
            !existsAfter(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid)) &&
            incoming().memberCount == existing().memberCount - 1
          ) ||
          // Group admin removes a member
          (
            existing().type == 'group' &&
            existing().createdBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount']) &&
            incoming().memberCount == existing().memberCount - 1 &&
            incoming().memberCount >= 1
          ) ||
          // Super Admin decrements memberCount during user account deletion
          (
            isSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount']) &&
            incoming().memberCount >= 0 &&
            incoming().memberCount <= existing().memberCount
          ) ||
          // Member sends a message and updates latest message preview for notifications
          (
            isChatMember(chatId) &&
            !isUserBanned(request.auth.uid) &&
            incoming().memberCount == existing().memberCount &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageAt', 'lastMessagePreview', 'lastSenderId', 'lastSenderUsername']) &&
            incoming().lastMessageAt == request.time &&
            incoming().lastSenderId == request.auth.uid
          )
        );

      allow delete: if isValidId(chatId) && canModRooms() && existing().type == 'group';

      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(memberId) && (
          isChatMember(chatId) ||
          isStaff() ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group'
        );

        allow list: if isSignedIn() && (isChatMember(chatId) || isStaff());

        allow create: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(memberId) &&
          isValidChatMember(incoming(), memberId) &&
          incoming().joinedAt == request.time &&
          !isUserBanned(request.auth.uid) &&
          exists(/databases/$(database)/documents/profiles/$(memberId)) &&
          (
            // Self-creating a group (public or private)
            (
              memberId == request.auth.uid &&
              getAfter(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' &&
              getAfter(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid
            ) ||
            // Self-joining a public group
            (
              memberId == request.auth.uid &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' &&
              (!('visibility' in get(/databases/$(database)/documents/chats/$(chatId)).data) ||
               get(/databases/$(database)/documents/chats/$(chatId)).data.visibility == 'public')
            ) ||
            // Group admin approving a private group join request
            (
              get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid &&
              exists(/databases/$(database)/documents/chats/$(chatId)/joinRequests/$(memberId))
            ) ||
            // Starting a DM (creator adds both self and target)
            (
              (
                memberId == request.auth.uid ||
                (
                  !exists(/databases/$(database)/documents/profiles/$(memberId)/blocks/$(request.auth.uid)) &&
                  !exists(/databases/$(database)/documents/profiles/$(request.auth.uid)/blocks/$(memberId))
                )
              ) &&
              getAfter(/databases/$(database)/documents/chats/$(chatId)).data.type == 'dm' &&
              getAfter(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid
            )
          );

        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(memberId) && (
          isOwner(memberId) ||
          isSuperAdmin() ||
          canModRooms() ||
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' &&
            isGroupAdmin(chatId) &&
            memberId != request.auth.uid
          )
        );

        allow update: if false;
      }

      match /typing/{userId} {
        allow get, list: if isSignedIn() && (
          isChatMember(chatId) ||
          (canModRooms() && get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group')
        );

        allow create, update: if isOwner(userId) &&
          isValidId(chatId) &&
          isValidId(userId) &&
          isValidTypingState(incoming(), userId) &&
          incoming().updatedAt == request.time &&
          isChatMember(chatId) &&
          !isUserBanned(userId);

        allow delete: if isValidId(chatId) && isValidId(userId) && (
          isOwner(userId) || isSuperAdmin() || canModRooms()
        );
      }

      match /reactions/{reactionId} {
        allow get, list: if isSignedIn() && (
          isChatMember(chatId) ||
          (canModRooms() && get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group')
        );

        allow create, update: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(reactionId) &&
          isValidReaction(incoming(), reactionId) &&
          incoming().updatedAt == request.time &&
          isChatMember(chatId) &&
          !isUserBanned(request.auth.uid);

        allow delete: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(reactionId) &&
          (
            (isChatMember(chatId) && existing().userId == request.auth.uid) ||
            canModRooms()
          );
      }

      match /readReceipts/{userId} {
        allow get, list: if isSignedIn() && (
          isChatMember(chatId) ||
          (canModRooms() && get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group')
        );

        allow create: if isOwner(userId) &&
          isValidId(chatId) &&
          isValidId(userId) &&
          isValidReadReceipt(incoming(), userId) &&
          incoming().lastDeliveredAt == request.time &&
          (!('lastReadAt' in incoming()) || incoming().lastReadAt == null || incoming().lastReadAt == request.time) &&
          isChatMember(chatId);

        allow update: if isOwner(userId) &&
          isValidId(chatId) &&
          isValidId(userId) &&
          isValidReadReceipt(incoming(), userId) &&
          incoming().lastDeliveredAt == request.time &&
          (
            incoming().lastReadAt == request.time ||
            (!('lastReadAt' in existing()) && (!('lastReadAt' in incoming()) || incoming().lastReadAt == null)) ||
            ('lastReadAt' in existing() && incoming().lastReadAt == existing().lastReadAt)
          ) &&
          isChatMember(chatId);

        allow delete: if isValidId(chatId) && isValidId(userId) && (
          isOwner(userId) || isSuperAdmin() || canModRooms()
        );
      }

      match /joinRequests/{requesterId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(requesterId) && (
          request.auth.uid == requesterId ||
          isGroupAdmin(chatId) ||
          canModRooms()
        );

        allow list: if isSignedIn() && (isGroupAdmin(chatId) || canModRooms());

        allow create: if isOwner(requesterId) &&
          isValidId(chatId) &&
          isValidId(requesterId) &&
          isValidJoinRequest(incoming(), requesterId) &&
          !isUserBanned(requesterId) &&
          !isChatMember(chatId) &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.visibility == 'private' &&
          incoming().status == 'pending' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(requesterId) &&
          isValidJoinRequest(incoming(), requesterId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              isGroupAdmin(chatId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
              incoming().status in ['approved', 'declined']
            ) ||
            (
              isOwner(requesterId) &&
              existing().status == 'declined' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'username', 'color', 'updatedAt']) &&
              incoming().status == 'pending'
            )
          );

        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(requesterId) && (
          request.auth.uid == requesterId ||
          isGroupAdmin(chatId) ||
          canModRooms()
        );
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() && isChatMember(chatId);
        allow list: if isSignedIn() && (
          isChatMember(chatId) ||
          (canModRooms() && get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group')
        );

        allow create: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          isValidMessage(incoming()) &&
          incoming().createdAt == request.time &&
          isChatMember(chatId) &&
          !isUserBanned(request.auth.uid) &&
          getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastMessageId == messageId;

        allow update: if false;

        allow delete: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          (
            (isChatMember(chatId) && existing().senderId == request.auth.uid) ||
            (canModRooms() && get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group')
          );

        match /views/{viewerId} {
          allow get: if isOwner(viewerId) && isValidId(chatId) && isValidId(messageId) && isValidId(viewerId) && isChatMember(chatId);
          allow create: if isOwner(viewerId) &&
            isValidId(chatId) &&
            isValidId(messageId) &&
            isValidId(viewerId) &&
            isChatMember(chatId) &&
            isValidMessageView(incoming(), viewerId) &&
            incoming().viewedAt == request.time &&
            !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)/views/$(viewerId));
          allow list, update, delete: if false;
        }
      }

      match /attachments/{attachmentId}/chunks/{chunkIndex} {
        allow get: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(attachmentId) &&
          isChatMember(chatId) &&
          (
            !existing().isViewOnce ||
            !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(existing().messageId)/views/$(request.auth.uid))
          );

        allow create: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(attachmentId) &&
          isValidAttachmentChunk(incoming(), chunkIndex) &&
          incoming().createdAt == request.time &&
          isChatMember(chatId) &&
          !isUserBanned(request.auth.uid);

        allow list, update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Moderation Reports (Create-Only for Users, Triage for Staff)
    // -------------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().reporterId == request.auth.uid &&
        (!('status' in incoming()) || incoming().status == 'pending') &&
        (!('resolvedBy' in incoming()) || incoming().resolvedBy == null) &&
        (!('resolvedAt' in incoming()) || incoming().resolvedAt == null) &&
        incoming().createdAt == request.time;

      allow get: if isStaff() && isValidId(reportId);
      allow list: if isStaff();

      allow update: if canModReports() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().reporterId == existing().reporterId &&
        incoming().reportedUserId == existing().reportedUserId &&
        incoming().chatId == existing().chatId &&
        incoming().messageId == existing().messageId &&
        incoming().reason == existing().reason &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedByUsername', 'resolutionNote', 'resolvedAt']) &&
        incoming().status in ['pending', 'resolved', 'dismissed'] &&
        incoming().resolvedBy == request.auth.uid &&
        incoming().resolvedAt == request.time;

      allow delete: if isSuperAdmin() && isValidId(reportId);
    }
  }
}
